# URL da página inicial do seu ambiente Coupa
COUPA_URL=https://sua-empresa.coupahost.com/user/home

# Opcional: histórico de recebimentos (padrão: montado a partir do COUPA_URL)
RECEBIMENTO_URL=

# Planilha com os números de pedido (PO)
EXCEL_PATH=C:\caminho\para\pedidos.xlsx

# Número da coluna com os números de PO (A=1, B=2, ... G=7)
COLUNA_REQ=7

# Pasta onde fica o perfil do navegador com a sessão salva
USER_DATA_DIR=./perfil_recebimento
